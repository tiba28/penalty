# Supabase 接続情報（Project Settings → API から取得）
# 実値は .env.local に記載する（.env.local は git 管理外）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# サーバー専用の秘密鍵（RLSをバイパス）。絶対に公開・フロント配置しない。
# NEXT_PUBLIC を付けないこと。Vercel では Environment Variables に別途登録する。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# セッションCookie署名用のシークレット（サーバー専用）。
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=your-random-session-secret
